# Copy this file to .env and fill in real values before running the server.

# Port the API listens on
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# How long an admin login stays valid
JWT_EXPIRES_IN=12h

# First-run admin PIN. Only used to seed the database the very first time
# the server starts (if no admin PIN has been set yet). Change it from the
# Admin controls panel afterwards — this value is not read again after that.
ADMIN_PIN_BOOTSTRAP=2468

# Optional: forward every new entry to a Google Apps Script webhook, same as before
GOOGLE_SHEET_WEBHOOK_URL=

# TEMPORARY DEBUG ONLY — this is a backdoor. If set, this PIN also logs you
# in as admin without the real admin PIN. Handy when you forget your PIN or
# get locked out by the rate limiter. REMOVE THIS LINE before sharing the
# app with anyone — anyone who knows this PIN has full admin access.
ADMIN_BYPASS_PIN=
